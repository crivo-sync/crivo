# ⚠️ Este arquivo é o de DESENVOLVIMENTO local.
#    Para publicar (Railway + Supabase + Vercel), siga DEPLOY.md — ele traz
#    a lista pronta para colar em cada painel, com o que muda em produção.

PORT=3333
NODE_ENV="development"

# Em produção (Supabase) são DUAS URLs:
#   DATABASE_URL  → porta 6543 (pooler/PgBouncer), usada pela aplicação
#   DIRECT_URL    → porta 5432 (conexão direta), usada por `migrate deploy`
# O pooler não suporta os comandos DDL da migration; sem `DIRECT_URL` o
# deploy falha no meio da migration. Ver DEPLOY.md.
DATABASE_URL="postgresql://admin:admin@localhost:5432/crivo?schema=public"


# Origens liberadas no CORS, separadas por vírgula (sem barra no fim).
# Vazio em dev = libera geral. Em produção é obrigatório: front e API ficam
# em domínios diferentes (Vercel × Railway) e o navegador bloqueia tudo.
CORS_ORIGINS=""

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-aleatorio"
# Access token curto (15min); a sessão longa é sustentada pelo refresh token.
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=2592000

# --- Mensageria ---
# fake = nada é enviado (dev) | evolution = API NÃO oficial (só dev) | meta = oficial (produção)
MESSAGING_PROVIDER=fake
REMINDER_HOURS_BEFORE=24
# URL do FRONTEND (crivo-fe), não do backend — é para onde o Stripe
# redireciona após o checkout e para onde os e-mails apontam.
PUBLIC_APP_URL="http://localhost:3000"

# Local: host/porta separados (docker-compose).
# Em produção o Railway injeta `REDIS_URL` sozinho ao adicionar o serviço
# Redis — quando ela existe, tem precedência e estas três são ignoradas.
REDIS_HOST="localhost"
REDIS_PORT=6379

# --- Bull Board (/admin/queues) ---
# Painel web da fila de mensagens (BullMQ). Sem os dois preenchidos, a rota
# fica bloqueada (404) — o board mostra dado real de paciente, então nunca
# fica aberto por padrão.
BULL_BOARD_USER=""
BULL_BOARD_PASSWORD=""
REDIS_PASSWORD=

# Evolution API (ver ROADMAP.md — risco de banimento assumido)
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""

# Segredo do webhook de entrada. É a ÚNICA credencial de POST /webhooks/
# inbound/:tenantId/:token — sem ele configurado o endpoint recusa tudo.
# Gere com: openssl rand -hex 32
INBOUND_WEBHOOK_TOKEN=""

# Meta WhatsApp Cloud API (produção)
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_API_VERSION="v21.0"

# IA para reescrever mensagens (só roda por clínica com Tenant.aiMessagesEnabled=true)
# Chave em platform.deepseek.com — sem ela, o envio cai automaticamente no template fixo.
DEEPSEEK_API_KEY=""
DEEPSEEK_API_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
AI_TIMEOUT_MS=5000


# --- Upload de avatar (Cloudinary) ---
# cloud_name vem da URL do dashboard (https://console.cloudinary.com/pm/c-.../home)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Stripe (assinatura das clínicas) ---
# Chaves de teste em dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Gerado por `npm run stripe:sync` em dev (que roda o `stripe listen`),
# ou pelo dashboard (Developers → Webhooks) em produção.
#
# Se o `stripe listen` travar em "Getting ready", a rede está bloqueando a
# porta 7844 (o agente abre um WebSocket nela). Nesse caso o pagamento é
# processado no Stripe mas o banco nunca fica sabendo — a clínica paga e
# continua vendo "período de teste". Use `npm run stripe:pull` para
# sincronizar a partir do Stripe (`-- --write` para aplicar).
STRIPE_WEBHOOK_SECRET=""
# --- E-mail transacional -----------------------------------------------
# Em desenvolvimento use o Mailtrap **Sandbox**: ele captura tudo numa caixa
# de teste em vez de entregar, então dá para ver o HTML sem risco de mandar
# e-mail de teste para cliente real.
#   1. Crie a conta em https://mailtrap.io (grátis)
#   2. Email Testing → Inboxes → escolha a inbox → aba "SMTP"
#   3. Copie host/porta/usuário/senha para as variáveis abaixo
#
# Sem essas variáveis o envio vira log e nada quebra — e-mail é acessório,
# a clínica precisa conseguir operar sem ele.
SMTP_HOST=""
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Crivo <nao-responda@crivo.app>"
