generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String  @id @default(uuid())
  name      String
  subdomain String  @unique
  isActive  Boolean @default(true) @map("is_active")

  // White-label / identidade visual
  logoUrl        String? @map("logo_url")
  primaryColor   String? @map("primary_color")
  secondaryColor String? @map("secondary_color")

  // Contato público da clínica
  phone   String?
  email   String?
  address String?

  /// Liga a reescrita das mensagens de WhatsApp por IA (DeepSeek). Desligado
  /// por padrão: sem custo extra nem dependência externa até a clínica optar.
  aiMessagesEnabled Boolean @default(false) @map("ai_messages_enabled")

  /// Por qual caminho o WhatsApp desta clínica sai.
  ///
  /// Nulo = usa o padrão do servidor (`MESSAGING_PROVIDER`), que é como todas
  /// as clínicas funcionavam antes. As credenciais seguem em variáveis de
  /// ambiente: aqui a clínica escolhe **qual** caminho usar, não guarda
  /// segredo no banco.
  messagingProvider MessagingProvider? @map("messaging_provider")

  /// Horário de funcionamento, em minutos desde a meia-noite (480 = 08:00).
  /// Inteiro em vez de String("08:00") de propósito: comparar agendamento com
  /// o expediente vira aritmética simples, sem parsing nem fuso no meio.
  /// O agendamento precisa CABER inteiro na janela — um procedimento de 90min
  /// às 17:00 com fechamento às 18:00 é recusado (terminaria 18:30).
  businessHoursStart Int @default(480) @map("business_hours_start")
  businessHoursEnd   Int @default(1080) @map("business_hours_end")

  /// Dias de funcionamento no padrão de `Date.getDay()`: 0=domingo … 6=sábado.
  /// Default seg–sex.
  businessDays Int[] @default([1, 2, 3, 4, 5]) @map("business_days")

  /// Toda clínica nasce em trial (sem `planId`). `planId` só é preenchido
  /// quando o checkout do Stripe completa — é o que distingue "ainda não
  /// escolheu plano" de "está pagando o Essencial", por exemplo.
  ///
  /// A assinatura em si continua como colunas do próprio Tenant, não um
  /// model `Subscription` separado: aqui é sempre 1 tenant = 1 assinatura,
  /// nunca precisou da tabela própria que o Stripe-por-usuário do
  /// snap-financial tem.
  subscriptionStatus   SubscriptionStatus @default(TRIALING) @map("subscription_status")
  trialEndsAt          DateTime           @map("trial_ends_at")
  planId               String?            @map("plan_id")
  plan                 Plan?              @relation(fields: [planId], references: [id])
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patients         Patient[]
  users            User[]
  professionals    Professional[]
  procedures       Procedure[]
  appointments     Appointment[]
  messages         Message[]
  inboundMessages  InboundMessage[]
  messageTemplates MessageTemplate[]
  waitlistEntries  WaitlistEntry[]
  anamneses        Anamnesis[]
  clinicalNotes    ClinicalNote[]
  clinicalPhotos   ClinicalPhoto[]
  schedules        ProfessionalSchedule[]
  timeOff          ProfessionalTimeOff[]

  @@map("tenants")
}

/// Status da assinatura da clínica. `TRIALING`/`EXPIRED` são geridos pelo
/// próprio backend (`SubscriptionGuard`, sem cron — ver o guard). Os demais
/// (`ACTIVE`, `PAST_DUE`, `CANCELED`) só existem depois do primeiro checkout
/// no Stripe, escritos pelo webhook (`mapStripeStatus`, mesmo padrão do
/// snap-financial).
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

/// Plano pago. Seedado manualmente (sem tela de admin ainda) a partir dos
/// produtos já criados no Stripe Dashboard — este model só espelha o que
/// existe lá, nunca cria produto/preço no Stripe em runtime.
model Plan {
  id           String @id @default(uuid())
  /// Chave estável usada no código (nunca o `name`, que é texto de UI e pode
  /// mudar). Ex.: `"BASICO"`.
  key          String @unique
  name         String
  /// Em centavos, como todo valor monetário no schema (`priceInCents` de
  /// `Procedure`/`Appointment`) — evita erro de arredondamento de float.
  priceInCents Int    @map("price_in_cents")

  /// Limites e features por plano. `null` em `maxProfessionals` = sem
  /// limite (usado pelo plano maior, "Rede"), não "zero profissionais".
  maxProfessionals    Int?    @map("max_professionals")
  /// Mensagens de saída por mês (`null` = sem teto). É o único custo
  /// variável por clínica: a Meta cobra por conversa iniciada pela
  /// empresa. Resposta a paciente dentro da janela de 24h não conta —
  /// nem para a Meta, nem aqui (ver `CheckMessageQuotaUseCase`).
  maxMessagesPerMonth Int?    @map("max_messages_per_month")
  hasPrediction       Boolean @default(false) @map("has_prediction")
  hasAiMessages       Boolean @default(false) @map("has_ai_messages")
  hasWaitlist         Boolean @default(false) @map("has_waitlist")
  hasDashboard        Boolean @default(false) @map("has_dashboard")
  /// Prontuário (anamnese + evolução). Diferencial do plano topo: é o
  /// módulo que o concorrente cobra à parte (R$29/mês avulso).
  hasMedicalRecords   Boolean @default(false) @map("has_medical_records")

  /// IDs do Stripe Dashboard. `stripePriceId` fica opcional porque o produto
  /// pode existir no Stripe antes de ter um Price ativo configurado.
  stripeProductId String  @unique @map("stripe_product_id")
  stripePriceId   String? @unique @map("stripe_price_id")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants Tenant[]

  @@map("plans")
}

enum Role {
  ADMIN
  /// Quem atende: enxerga prontuário (dado sensível de saúde). A recepção
  /// (STAFF) fica de fora de propósito — não tem necessidade clínica de ler
  /// alergia/medicação, e a LGPD trata isso como dado sensível.
  PROFESSIONAL
  STAFF
}

model User {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  email     String   @unique
  password  String
  avatarUrl String?  @map("avatar_url")
  role      Role     @default(STAFF)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  refreshTokens    RefreshToken[]
  professional     Professional?
  clinicalNotes    ClinicalNote[]
  clinicalPhotos   ClinicalPhoto[]
  anamnesesUpdated Anamnesis[]

  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Patient {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  name      String
  cpf       String?
  phone     String
  email     String?
  // Soft delete: agendamentos passados precisam continuar apontando para o
  // paciente, e o histórico de faltas é a matéria-prima da predição.
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  appointments    Appointment[]
  anamnesis       Anamnesis?
  clinicalNotes   ClinicalNote[]
  clinicalPhotos  ClinicalPhoto[]
  messages        Message[]
  inboundMessages InboundMessage[]
  waitlistEntries WaitlistEntry[]

  @@unique([tenantId, cpf])
  @@index([tenantId])
  @@map("patients")
}

/// Ficha de saúde do paciente — uma por paciente, atualizada ao longo do
/// tempo. Separada de `Patient` porque cadastro é dado comum e isto é dado
/// sensível de saúde: leitura restrita a ADMIN/PROFESSIONAL.
model Anamnesis {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  patientId String @unique @map("patient_id")

  /// Campos clínicos como texto livre: cada clínica pergunta de um jeito, e
  /// engessar em colunas agora obrigaria migration a cada especialidade nova.
  allergies    String?
  medications  String?
  conditions   String?
  observations String?

  /// Rastreabilidade do registro: quem preencheu por último.
  updatedByUserId String?  @map("updated_by_user_id")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant  @relation(fields: [tenantId], references: [id])
  patient       Patient @relation(fields: [patientId], references: [id])
  updatedByUser User?   @relation(fields: [updatedByUserId], references: [id])

  @@index([tenantId])
  @@map("anamneses")
}

/// Nota de evolução clínica.
///
/// **Append-only de propósito**: não tem `updatedAt` nem `deletedAt`, e não
/// existe rota de PUT/DELETE. Registro clínico não se reescreve — errou,
/// adiciona uma nota nova corrigindo. A ausência dos campos é o que impede
/// alterar histórico por engano, sem precisar construir versionamento.
model ClinicalNote {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  patientId String @map("patient_id")

  /// Opcional: a nota pode existir sem agendamento (retorno espontâneo,
  /// registro feito depois).
  appointmentId String? @map("appointment_id")
  authorUserId  String  @map("author_user_id")

  content   String
  createdAt DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  author      User         @relation(fields: [authorUserId], references: [id])

  @@index([tenantId, patientId, createdAt])
  @@map("clinical_notes")
}

/// Quem atende. Pode ou não ter login: em muitas clínicas só a recepção usa o
/// sistema, então `userId` é opcional.
model Professional {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  userId      String?   @unique @map("user_id")
  name        String
  specialty   String?
  /// Registro do conselho (CRO, CRM...)
  councilCode String?   @map("council_code")
  phone       String?
  email       String?
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant          Tenant                 @relation(fields: [tenantId], references: [id])
  user            User?                  @relation(fields: [userId], references: [id])
  appointments    Appointment[]
  schedules       ProfessionalSchedule[]
  timeOff         ProfessionalTimeOff[]
  /// Procedimentos que este profissional realiza. Lista vazia = faz todos
  /// (sem restrição) — só passa a filtrar o agendamento quando o admin
  /// marca especialidades específicas.
  procedures      Procedure[]            @relation("ProfessionalProcedures")
  waitlistEntries WaitlistEntry[]

  @@index([tenantId])
  @@map("professionals")
}

/// Uma faixa de atendimento do profissional num dia da semana.
///
/// É uma linha por faixa, não uma por dia: assim "segunda 08–12" e
/// "segunda 14–18" convivem, que é como se representa intervalo de almoço.
/// Profissional **sem nenhuma linha** atende no expediente inteiro da
/// clínica — mesma regra dos procedimentos, para não travar quem já existe.
model ProfessionalSchedule {
  id             String @id @default(uuid())
  tenantId       String @map("tenant_id")
  professionalId String @map("professional_id")

  /// 0=domingo … 6=sábado — mesma convenção de `Date.getDay()` e de
  /// `Tenant.businessDays`.
  weekday Int

  /// Minutos desde a meia-noite, igual a `Tenant.businessHoursStart`.
  /// Inteiro em vez de String("08:00") pelo mesmo motivo: comparar vira
  /// aritmética, sem parsing nem fuso no meio.
  startMinutes Int @map("start_minutes")
  endMinutes   Int @map("end_minutes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId, professionalId, weekday])
  @@map("professional_schedules")
}

/// Ausência pontual: férias, congresso, compromisso pessoal.
///
/// Bloqueia a agenda no intervalo independentemente da grade semanal — é o
/// "hoje não" que a grade recorrente não consegue expressar.
model ProfessionalTimeOff {
  id             String @id @default(uuid())
  tenantId       String @map("tenant_id")
  professionalId String @map("professional_id")

  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")
  reason   String?

  createdAt DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId, professionalId, startsAt])
  @@map("professional_time_off")
}

/// O que é feito na consulta. Define duração padrão e preço.
model Procedure {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  name            String
  description     String?
  /// Duração padrão em minutos — usada para calcular endsAt do agendamento.
  durationMinutes Int       @map("duration_minutes")
  /// Preço em centavos: dinheiro nunca em float.
  priceInCents    Int       @map("price_in_cents")
  isActive        Boolean   @default(true) @map("is_active")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  appointments    Appointment[]
  professionals   Professional[]  @relation("ProfessionalProcedures")
  waitlistEntries WaitlistEntry[]

  @@index([tenantId])
  @@map("procedures")
}

/// De onde veio o agendamento.
enum AppointmentOrigin {
  /// Marcado por alguém da clínica, pelo painel.
  STAFF
  /// Marcado pelo próprio paciente, na página pública.
  ONLINE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Situação de quem está esperando uma vaga.
enum WaitlistStatus {
  /// Esperando. É o único estado que aparece quando abre uma vaga.
  WAITING
  /// Foi avisado de uma vaga e a clínica aguarda resposta.
  OFFERED
  /// Virou agendamento — `appointmentId` aponta para ele.
  SCHEDULED
  /// Saiu da fila: desistiu, remarcou por fora, ou a clínica removeu.
  CANCELLED
}

/// Paciente esperando uma vaga.
///
/// Existe para o buraco que o cancelamento abre: hoje uma consulta cancelada
/// na véspera simplesmente evapora, e a recepção não tem lista de quem
/// gostaria daquele horário. É também o destino da vaga liberada por risco
/// alto de falta — ver `prediction` no ROADMAP.
model WaitlistEntry {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  patientId      String  @map("patient_id")
  /// Opcional: "qualquer profissional" é o caso comum de quem só quer ser
  /// atendido logo. Preenchido quando o paciente faz questão de alguém.
  professionalId String? @map("professional_id")
  /// O que ele quer fazer — define a duração da vaga que serve para ele.
  procedureId    String  @map("procedure_id")

  /// Janela em que o paciente aceita ser encaixado. Nulo = qualquer data.
  preferredFrom DateTime? @map("preferred_from")
  preferredTo   DateTime? @map("preferred_to")

  /// Observação da recepção ("só de manhã", "avisar pelo fixo").
  notes String?

  status WaitlistStatus @default(WAITING)

  /// Quando a vaga foi oferecida e por qual agendamento cancelado. Guardado
  /// para a recepção saber há quanto tempo espera resposta.
  offeredAt     DateTime? @map("offered_at")
  /// Agendamento criado a partir desta espera.
  appointmentId String?   @map("appointment_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])
  procedure    Procedure     @relation(fields: [procedureId], references: [id])

  /// A busca é sempre "quem está esperando nesta clínica", ordenada por
  /// chegada — quem entrou primeiro tem preferência.
  @@index([tenantId, status, createdAt])
  @@index([patientId])
  @@map("waitlist_entries")
}

model Appointment {
  id                String            @id @default(uuid())
  tenantId          String            @map("tenant_id")
  patientId         String            @map("patient_id")
  professionalId    String            @map("professional_id")
  procedureId       String            @map("procedure_id")
  startsAt          DateTime          @map("starts_at")
  endsAt            DateTime          @map("ends_at")
  status            AppointmentStatus @default(SCHEDULED)
  /// Quem marcou. `ONLINE` é o paciente pelo site — a recepção precisa
  /// distinguir para conferir horário nobre ocupado por alguém que ela não
  /// atendeu, e para saber que aquele cadastro veio sem triagem.
  origin            AppointmentOrigin @default(STAFF)
  notes             String?
  /// Preço praticado no ato — copiado do procedimento, pois o preço de tabela
  /// muda com o tempo e o histórico não pode mudar junto.
  priceInCents      Int               @map("price_in_cents")
  confirmedAt       DateTime?         @map("confirmed_at")
  cancelledAt       DateTime?         @map("cancelled_at")
  cancelReason      String?           @map("cancel_reason")
  /// Token do link enviado ao paciente. Ele confirma sem precisar de login,
  /// então o token é a única credencial — opaco e único.
  confirmationToken String?           @unique @map("confirmation_token")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  patient         Patient          @relation(fields: [patientId], references: [id])
  professional    Professional     @relation(fields: [professionalId], references: [id])
  procedure       Procedure        @relation(fields: [procedureId], references: [id])
  messages        Message[]
  inboundMessages InboundMessage[]
  clinicalNotes   ClinicalNote[]
  clinicalPhotos  ClinicalPhoto[]

  // Busca da agenda: sempre por tenant + profissional + janela de tempo.
  @@index([tenantId, professionalId, startsAt])
  @@index([tenantId, startsAt])
  @@index([patientId])
  @@map("appointments")
}

/// Texto personalizado de uma mensagem automática.
///
/// Uma linha por (tenant, tipo). Ausente = o template fixo do código, que
/// segue sendo o padrão: clínica que nunca personalizou continua funcionando
/// sem nenhuma linha aqui.
model MessageTemplate {
  id       String      @id @default(uuid())
  tenantId String      @map("tenant_id")
  type     MessageType

  /// Texto com marcadores `{{paciente}}`, `{{data}}` etc. Os marcadores
  /// disponíveis dependem do `type` — ver `MessageTemplateService`.
  body String

  /// Desligar volta ao texto padrão sem perder o que foi escrito. Sem isso, a
  /// clínica precisaria apagar o próprio texto para testar o padrão.
  isActive Boolean @default(true) @map("is_active")

  updatedByUserId String?  @map("updated_by_user_id")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, type])
  @@map("message_templates")
}

/// Por onde o WhatsApp sai. As credenciais de cada um ficam em variáveis de
/// ambiente do servidor — este enum só diz qual caminho a clínica usa.
enum MessagingProvider {
  /// Nada é enviado de verdade. Serve para demonstrar o produto e para
  /// desenvolver sem gastar conversa nem arriscar o número.
  FAKE
  /// Camada não oficial sobre o WhatsApp Web. Barata, mas a Meta não
  /// autoriza e o banimento do número é permanente — ver ROADMAP.
  EVOLUTION
  /// Cloud API oficial. Cobra por conversa e não corre risco de banimento.
  META
}

enum MessageChannel {
  WHATSAPP
  SMS
}

enum MessageType {
  /// Enviada na hora em que a consulta é marcada, quando o lembrete D-1
  /// ainda está longe — senão o paciente ficaria dias sem nenhum aviso.
  APPOINTMENT_BOOKED
  APPOINTMENT_REMINDER
  APPOINTMENT_CONFIRMATION_RECEIPT
  /// Aviso de que abriu uma vaga, para quem está na lista de espera.
  /// Tipo próprio (e não `MANUAL`) para a clínica conseguir medir quantas
  /// ofertas viram agendamento — é o que diz se a fila funciona.
  WAITLIST_OFFER
  MANUAL
}

enum MessageStatus {
  /// Na fila, ainda não tentada.
  PENDING
  /// Estava agendada mas perdeu a validade antes de sair — hoje só acontece
  /// quando o agendamento é remarcado e o lembrete antigo (com a data velha)
  /// é descartado. Nunca foi enviada ao paciente.
  CANCELLED
  SENT
  /// Confirmado pelo provider (Meta devolve status de entrega).
  DELIVERED
  /// Esgotou as tentativas. É este status que alimenta a lista de
  /// "ligar para estes pacientes" — falha nunca é silenciosa.
  FAILED
}

/// Rastro de cada mensagem. Existe para três coisas: saber o que foi enviado,
/// expor as falhas para a recepção agir, e contar conversas por clínica
/// (base da franquia de cobrança).
model Message {
  id                String         @id @default(uuid())
  tenantId          String         @map("tenant_id")
  appointmentId     String?        @map("appointment_id")
  /// Direto no paciente, não só via `appointment.patientId` — uma resposta
  /// manual (`MANUAL`) precisa existir sem consulta associada, e sem esta
  /// coluna a mensagem ficaria sem vínculo nenhum. Espelha `InboundMessage`,
  /// que já resolvia isso pelo telefone desde o webhook de entrada.
  patientId         String?        @map("patient_id")
  channel           MessageChannel @default(WHATSAPP)
  type              MessageType
  status            MessageStatus  @default(PENDING)
  /// Telefone destino, congelado no envio (o cadastro pode mudar depois).
  toPhone           String         @map("to_phone")
  body              String
  /// Qual provider tratou o envio: fake | evolution | meta.
  provider          String?
  /// Id da mensagem no provider, para conciliar status de entrega.
  providerMessageId String?        @map("provider_message_id")
  attempts          Int            @default(0)
  lastError         String?        @map("last_error")
  /// Quando deve sair da fila (lembrete D-1 é agendado, não imediato).
  scheduledFor      DateTime?      @map("scheduled_for")
  sentAt            DateTime?      @map("sent_at")
  failedAt          DateTime?      @map("failed_at")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  patient     Patient?     @relation(fields: [patientId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([appointmentId])
  @@index([patientId])
  @@map("messages")
}

/// Mensagem recebida do paciente.
///
/// Tabela separada de `Message` de propósito: aquela é um registro de envio
/// (tem fila, tentativas, agendamento, destino) e nada disso existe na
/// entrada. Espremer as duas num modelo só deixaria metade das colunas
/// sempre nulas e o significado de `status` ambíguo.
model InboundMessage {
  id                String         @id @default(uuid())
  tenantId          String         @map("tenant_id")
  /// Resolvido pelo telefone quando bate com um cadastro. Fica nulo quando
  /// escreve um número desconhecido — a mensagem é guardada mesmo assim, ou
  /// perderíamos justamente o contato de quem ainda não é paciente.
  patientId         String?        @map("patient_id")
  channel           MessageChannel @default(WHATSAPP)
  /// Telefone de origem, só dígitos com DDI (mesma normalização do envio).
  fromPhone         String         @map("from_phone")
  body              String
  provider          String?
  /// Id da mensagem no provider. Único por tenant: o webhook do WhatsApp
  /// reentrega o mesmo evento em retry, e sem isso a conversa duplicaria.
  providerMessageId String?        @map("provider_message_id")
  /// Quando o paciente enviou (relógio do provider), não quando recebemos.
  sentAt            DateTime       @map("sent_at")
  /// Preenchido quando alguém da clínica dá a mensagem por tratada.
  readAt            DateTime?      @map("read_at")

  /// O que o sistema entendeu da resposta. Guardado (em vez de recalculado na
  /// leitura) porque é o registro de **por que** um agendamento foi
  /// confirmado sozinho — se o vocabulário mudar depois, o histórico continua
  /// explicando a decisão que foi tomada na época.
  intent        ReplyIntent @default(UNKNOWN)
  /// Agendamento afetado por esta resposta. Nulo quando a intenção foi
  /// `UNKNOWN`, ou quando não havia agendamento elegível para confirmar.
  appointmentId String?     @map("appointment_id")

  createdAt DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  patient     Patient?     @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@unique([tenantId, providerMessageId])
  @@index([tenantId, createdAt])
  @@index([tenantId, readAt])
  @@index([patientId])
  @@map("inbound_messages")
}

/// Momento que a foto clínica registra.
enum ClinicalPhotoKind {
  BEFORE
  AFTER
}

/// Foto clínica (antes/depois) de um atendimento.
///
/// **Dado sensível de saúde**, como o prontuário: mesma restrição de papel
/// (ADMIN/PROFESSIONAL) e mesma feature de plano (`hasMedicalRecords`).
///
/// O arquivo NÃO fica em URL pública. Sobe para o Cloudinary como
/// `authenticated` e só é servido por URL assinada com expiração — link de
/// foto clínica acaba em histórico de navegador, print e conversa de
/// WhatsApp, e um link permanente vaza para sempre.
///
/// Ligada ao **atendimento**, não só ao paciente: em estética o que importa
/// é "resultado da aplicação de 12/08", e é o atendimento que dá data,
/// procedimento e profissional de graça. A galeria por paciente continua
/// possível — basta agrupar pelos atendimentos dele.
model ClinicalPhoto {
  id            String @id @default(uuid())
  tenantId      String @map("tenant_id")
  patientId     String @map("patient_id")
  appointmentId String @map("appointment_id")

  kind ClinicalPhotoKind

  /// `public_id` no Cloudinary. É com ele que a URL assinada é gerada a cada
  /// leitura — nunca guardamos uma URL pronta, que expiraria no banco.
  storageKey String  @map("storage_key")
  caption    String?

  /// Quem enviou. Foto clínica é registro: sem autor, não há responsável.
  uploadedByUserId String @map("uploaded_by_user_id")

  createdAt DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  patient     Patient     @relation(fields: [patientId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])
  uploadedBy  User        @relation(fields: [uploadedByUserId], references: [id])

  @@index([tenantId, patientId, createdAt])
  @@index([appointmentId])
  @@map("clinical_photos")
}

/// Interpretação da resposta do paciente ao lembrete.
enum ReplyIntent {
  /// Resposta inequívoca de presença ("sim", "confirmo", "ok").
  CONFIRM
  /// Pedido claro de cancelar/remarcar. Hoje **não** cancela sozinho: só
  /// sinaliza para a recepção, porque cancelar é decisão da clínica.
  CANCEL
  /// Não deu para entender com segurança. É o padrão: confirmar presença de
  /// quem não confirmou é pior do que pedir para um humano ler.
  UNKNOWN
}
